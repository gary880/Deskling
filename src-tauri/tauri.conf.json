{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Deskling",
  "version": "0.1.0",
  "identifier": "com.deskling.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "control",
        "url": "index.html?view=control",
        "title": "Deskling Pet Lab",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "pet",
        "url": "index.html?view=pet",
        "title": "Deskling Pet",
        "width": 320,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "backgroundThrottling": "disabled",
        "visible": false
      },
      {
        "label": "conversation",
        "url": "index.html?view=conversation",
        "title": "Deskling Conversation",
        "width": 380,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "backgroundThrottling": "disabled",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/pets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
